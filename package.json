{
  "name": "roselle-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "vite --config vite.config.app.ts --host 127.0.0.1",
    "build:index": "tsc -b && vite build --config vite.config.index.ts",
    "build:app": "tsc -b && vite build --config vite.config.app.ts",
    "build:all": "npm run build:index && npm run build:app",
    "build": "npm run build:app",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}