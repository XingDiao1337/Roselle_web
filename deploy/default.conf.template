server {
    listen 80 default_server;
    server_name _;
    return 404;
}
server {
    listen 80;
    server_name ${WEB_HOST};
    root /usr/share/nginx/html;
    client_max_body_size 128m;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;
    location /api/web/ {
        proxy_pass http://backend:1337;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 80;
    server_name ${INJECTOR_HOST};
    location /api/injector/ {
        proxy_pass http://backend:1337;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location / { return 404; }
}
server {
    listen 80;
    server_name ${DLL_HOST};
    location /api/dll/ {
        proxy_pass http://backend:1337;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location / { return 404; }
}
